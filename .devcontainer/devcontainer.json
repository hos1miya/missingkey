{
	"name": "Misskey",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22.11.0"
		},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {
			"version": "10.11.0"
		}
	},
	"forwardPorts": [3000],
	"postCreateCommand": "/bin/bash .devcontainer/init.sh"
}
